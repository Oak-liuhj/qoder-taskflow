{
  "name": "dsh-taskflow",
  "version": "0.1.4",
  "description": "智能任务编排：持久层级计划、按需递归子会话与完成通知",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./icon": "./assets/icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "src/domain/*.mjs",
    "src/application/*.mjs",
    "src/storage/*.mjs",
    "src/server/*.mjs",
    "assets/icon.svg",
    "assets/icon.png",
    "locale/*.json",
    "cordis.patch.yml",
    "README.md",
    "README_en.md",
    "CHANGELOG.md",
    "NOTICE",
    "LICENSE",
    "licenses/*.txt",
    "docs/DETAIL.md",
    "docs/DETAIL.zh-CN.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:check": "node scripts/build.mjs --check",
    "test": "node --test test/*.test.mjs",
    "check": "npm run build:check && npm test && npm run check:release",
    "check:release": "node scripts/check-release.mjs",
    "check:package": "node scripts/check-package.mjs",
    "prepack": "npm run build && npm test && npm run check:release",
    "dev": "node scripts/dev.mjs",
    "check:hosts": "node scripts/check-hosts.mjs",
    "build:qoder": "node scripts/build-qoder.mjs",
    "test:qoder": "node --test test/qoder.test.mjs"
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.1-rc.3 <1.0.0-0 || >=0.2.2-0 <1.0.0-0 || >=0.2.3-0 <1.0.0-0 || >=0.3.0-0 <1.0.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5 || ~4.1.0",
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.3 <1.0.0-0 || >=0.2.2-0 <1.0.0-0 || >=0.2.3-0 <1.0.0-0 || >=0.3.0-0 <1.0.0-0",
    "@deepseek-ai/dsh-subagent": ">=0.2.1-rc.3 <1.0.0-0 || >=0.2.2-0 <1.0.0-0 || >=0.2.3-0 <1.0.0-0 || >=0.3.0-0 <1.0.0-0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.3 <1.0.0-0 || >=0.2.2-0 <1.0.0-0 || >=0.2.3-0 <1.0.0-0 || >=0.3.0-0 <1.0.0-0",
    "@deepseek-ai/schemastery": "~3.18.5 || ~3.19.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.2",
    "@deepseek-ai/dsh-agent-loop": "0.2.2-rc.2",
    "@deepseek-ai/dsh-agent-loop-testkit": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.2-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.2.2-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.2",
    "@deepseek-ai/dsh-session": "0.2.2-rc.2",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.2.2-rc.2",
    "@deepseek-ai/dsh-subagent": "0.2.2-rc.2",
    "@deepseek-ai/dsh-subagent-spawn-in-process": "0.2.2-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.2",
    "@deepseek-ai/schemastery": "3.19.0",
    "@modelcontextprotocol/ext-apps": "2.0.4",
    "@modelcontextprotocol/sdk": "1.32.2",
    "esbuild": "0.25.12",
    "fflate": "0.8.3",
    "jsdom": "26.1.0",
    "marked": "18.2.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "semver": "7.7.3",
    "yaml": "2.8.1"
  },
  "license": "(Apache-2.0 AND MIT)",
  "author": "Oak-liuhj",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Oak-liuhj/dsh-taskflow.git"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "taskflow",
    "task-tree",
    "workflow",
    "orchestration",
    "subagents"
  ],
  "homepage": "https://github.com/Oak-liuhj/dsh-taskflow#readme",
  "bugs": {
    "url": "https://github.com/Oak-liuhj/dsh-taskflow/issues"
  },
  "icon": "assets/icon.png",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "latest"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
