{
  "name": "qoder-taskflow",
  "version": "0.1.0",
  "private": true,
  "description": "Qoder 插件：持久任务树、原生聊天子会话委派、执行记录与结果交接",
  "type": "module",
  "scripts": {
    "build": "node scripts/build-qoder.mjs",
    "build:qoder": "npm run build",
    "test": "node --test test/*.test.mjs",
    "test:qoder": "node --test test/qoder.test.mjs",
    "check": "npm test && npm run check:release",
    "check:release": "node scripts/check-release.mjs",
    "check:package": "npm run check:release"
  },
  "engines": {
    "node": ">=24.9.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/ext-apps": "2.0.4",
    "@modelcontextprotocol/sdk": "1.32.2",
    "esbuild": "0.25.12",
    "fflate": "0.8.3",
    "jsdom": "26.1.0",
    "marked": "18.2.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "license": "Apache-2.0",
  "author": "Oak-liuhj",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Oak-liuhj/qoder-taskflow.git"
  },
  "homepage": "https://github.com/Oak-liuhj/qoder-taskflow#readme",
  "bugs": {
    "url": "https://github.com/Oak-liuhj/qoder-taskflow/issues"
  },
  "keywords": [
    "qoder",
    "qoder-plugin",
    "taskflow",
    "task-tree",
    "workflow",
    "subagents"
  ]
}
